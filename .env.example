# ── Database ──────────────────────────────────────────────
# Local development: SQLite file (used by the Prisma CLI for migrations)
DATABASE_URL="file:./dev.db"
# Production: your Turso database. Leave empty locally to use prisma/dev.db
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# ── Auth ──────────────────────────────────────────────────
# Required in production. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"
# Public URL of the app. Optional on Vercel (detected automatically); used in WhatsApp links.
NEXTAUTH_URL="http://localhost:3000"
# Trust the X-Forwarded-Host header (needed behind Codespaces / proxies)
AUTH_TRUST_HOST=true

# ── Registration ──────────────────────────────────────────
# Initial invite code (the admin can change it later from "Vecinos")
INVITE_CODE="PALAPA2026"
