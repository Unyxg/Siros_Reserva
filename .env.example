# ── Database ──────────────────────────────────────────────
# Local development: SQLite file (used by the Prisma CLI for migrations)
DATABASE_URL="file:./dev.db"
# Production: your Turso database. Leave empty locally to use prisma/dev.db
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# ── Auth ──────────────────────────────────────────────────
# Required in production. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"
# Public URL of the app. Optional on Vercel (detected automatically); used in WhatsApp links.
NEXTAUTH_URL="http://localhost:3000"
# Trust the X-Forwarded-Host header (needed behind Codespaces / proxies)
AUTH_TRUST_HOST=true

# ── Registration ──────────────────────────────────────────
# Initial invite code (the admin can change it later from "Vecinos")
INVITE_CODE="PALAPA2026"

# ── WhatsApp Cloud API (Meta) – optional ──────────────────
# Without these, notices use free "click to send" WhatsApp buttons instead.
WHATSAPP_TOKEN=""                   # permanent System User token
WHATSAPP_PHONE_NUMBER_ID=""         # WhatsApp Manager → Phone numbers → Phone number ID
WHATSAPP_BUSINESS_ACCOUNT_ID=""     # only needed by `npm run whatsapp:templates`
# WHATSAPP_TEMPLATE_LANG="es_MX"
# WHATSAPP_API_VERSION="v23.0"
# Public address used in template buttons (only for `npm run whatsapp:templates`)
APP_URL="https://siros-reserva.vercel.app"
