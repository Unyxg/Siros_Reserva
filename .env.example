# ── Database ──────────────────────────────────────────────
# Local development: SQLite file (used by the Prisma CLI for migrations)
DATABASE_URL="file:./dev.db"
# Production (Vercel): your Turso database. Leave empty locally to use prisma/dev.db
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# ── Auth ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"
# Public URL of the app (in production: https://your-domain.com). Also used in email links.
NEXTAUTH_URL="http://localhost:3000"
# Trust the X-Forwarded-Host header (needed behind Codespaces / proxies)
AUTH_TRUST_HOST=true

# ── Email (Resend) ────────────────────────────────────────
# Without a key, emails are only printed in the terminal (handy for development)
RESEND_API_KEY=""
# Must be an address on a domain you verified in Resend
EMAIL_FROM="Reserva la Palapa <avisos@tu-dominio.com>"

# ── Registration ──────────────────────────────────────────
# Initial invite code (the admin can change it later from "Vecinos")
INVITE_CODE="PALAPA2026"
