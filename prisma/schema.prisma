// Prisma schema for the Palapa reservation system.
// Locally this is a SQLite file (prisma/dev.db); in production the same schema runs on Turso (libSQL).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  APPROVER
  ADMIN
}

enum UserStatus {
  PENDING // registered, waiting for an admin to approve the account
  ACTIVE
  DISABLED
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  // House / unit number so approvers know which neighbor is asking
  house     String?
  phone     String?
  role      Role       @default(USER)
  status    UserStatus @default(PENDING)
  createdAt DateTime   @default(now())

  reservations Reservation[]        @relation("ReservationOwner")
  reviewed     Reservation[]        @relation("ReservationReviewer")
  resetTokens  PasswordResetToken[]
}

model Reservation {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation("ReservationOwner", fields: [userId], references: [id], onDelete: Cascade)
  // Stored as plain strings ("YYYY-MM-DD" / "HH:mm") to avoid timezone surprises
  date      String
  startTime String
  endTime   String
  guests    Int?
  status    ReservationStatus @default(PENDING)
  reason    String

  // Filled in by the approver
  reviewNote   String?
  reviewedById String?
  reviewedBy   User?     @relation("ReservationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  // Filled in when the resident or staff cancels, freeing the slot
  cancelReason String?
  cancelledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([status])
  @@index([userId])
}

/// Days the admin closes the Palapa (maintenance, holidays…).
model BlockedDate {
  id        String   @id @default(cuid())
  date      String   @unique // "YYYY-MM-DD"
  reason    String
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  // Only a SHA-256 hash of the token is stored; the raw token lives in the email link
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/// Simple key/value settings editable by the admin (e.g. the invite code).
model Setting {
  key   String @id
  value String
}
