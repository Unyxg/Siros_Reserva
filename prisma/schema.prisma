// Prisma schema for the Palapa reservation system.
// SQLite keeps the database self-contained (a single file in /prisma).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  APPROVER
  ADMIN
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  // House / unit number so approvers know which neighbor is asking
  house     String?
  phone     String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  reservations Reservation[] @relation("ReservationOwner")
  reviewed     Reservation[] @relation("ReservationReviewer")
}

model Reservation {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation("ReservationOwner", fields: [userId], references: [id], onDelete: Cascade)
  // Stored as plain strings ("YYYY-MM-DD" / "HH:mm") to avoid timezone surprises
  date      String
  startTime String
  endTime   String
  guests    Int?
  status    ReservationStatus @default(PENDING)
  reason    String

  // Filled in by the approver
  reviewNote   String?
  reviewedById String?
  reviewedBy   User?     @relation("ReservationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([status])
  @@index([userId])
}
